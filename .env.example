# Copie para .env e ajuste os valores: cp .env.example .env
# POSTGRES_PASSWORD deve ser igual ao user-secret Database:Password do Kitsuneo.API

POSTGRES_DB=kitsuneo
POSTGRES_USER=kitsuneo
POSTGRES_PASSWORD=

POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# UID/GID do seu usuário no host (id -u / id -g), para o backend ler o secrets.json
HOST_UID=1000
HOST_GID=1000

# Diretório do user-secrets no host (padrão: ~/.microsoft/usersecrets)
# Windows: USER_SECRETS_DIR=${APPDATA}/Microsoft/UserSecrets
# USER_SECRETS_DIR=
